#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
host="all"
update_mode="preserve"
links_only=0
quiet=0

usage() {
  cat <<'EOF'
usage: ./setup [--host codex|claude|all] [--auto-update|--no-auto-update] [--quiet]
EOF
}

log() {
  if [ "$quiet" -eq 0 ]; then
    printf '%s\n' "$*"
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host)
      [ $# -ge 2 ] || { echo "missing value for --host" >&2; exit 1; }
      host="$2"
      shift 2
      ;;
    --host=*) host="${1#--host=}"; shift ;;
    --auto-update) update_mode="enable"; shift ;;
    --no-auto-update) update_mode="disable"; shift ;;
    --links-only) links_only=1; shift ;;
    -q|--quiet) quiet=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

case "$host" in
  codex|claude|all) ;;
  *) echo "unknown host: $host" >&2; exit 1 ;;
esac

state_dir="${NODUMBMODE_STATE_DIR:-$HOME/.nodumbmode}"
codex_root="${NODUMBMODE_CODEX_DIR:-${CODEX_HOME:-$HOME/.codex}}"
claude_root="${NODUMBMODE_CLAUDE_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
codex_skills="$codex_root/skills"
claude_skills="$claude_root/skills"
hook_helper="$repo_root/bin/nodumbmode-hook-config"
updater="$repo_root/bin/nodumbmode-update"

link_skills() {
  local skills_dir="$1"
  local skill_file skill_dir skill_name target link_dest
  local linked=()

  mkdir -p "$skills_dir"

  for target in "$skills_dir"/*; do
    [ -L "$target" ] || continue
    link_dest="$(readlink "$target" 2>/dev/null || true)"
    case "$link_dest" in
      "$repo_root"/*)
        skill_name="$(basename "$target")"
        if [ ! -f "$repo_root/$skill_name/SKILL.md" ]; then
          rm -f "$target"
          log "removed stale link: $target"
        fi
        ;;
    esac
  done

  for skill_file in "$repo_root"/*/SKILL.md; do
    [ -f "$skill_file" ] || continue
    skill_dir="$(dirname "$skill_file")"
    skill_name="$(basename "$skill_dir")"
    target="$skills_dir/$skill_name"

    if [ -e "$target" ] && [ ! -L "$target" ]; then
      echo "nodumbmode: $target already exists and is not a symlink; skipped" >&2
      continue
    fi

    ln -sfn "$skill_dir" "$target"
    linked+=("$skill_name")
  done

  if [ ${#linked[@]} -gt 0 ]; then
    log "linked to $skills_dir: ${linked[*]}"
  fi
}

if [ "$host" = "codex" ] || [ "$host" = "all" ]; then
  link_skills "$codex_skills"
fi

if [ "$host" = "claude" ] || [ "$host" = "all" ]; then
  link_skills "$claude_skills"
fi

if [ "$links_only" -eq 1 ]; then
  exit 0
fi

mkdir -p "$state_dir"
printf '%s\n' "$host" > "$state_dir/host"

configure_hook() {
  local action="$1"
  local hook_host="$2"
  local config_path="$3"

  "$hook_helper" "$action" "$hook_host" "$config_path" "$updater"
}

case "$update_mode" in
  enable)
    if [ "$host" = "codex" ] || [ "$host" = "all" ]; then
      configure_hook add codex "$codex_root/hooks.json"
    fi
    if [ "$host" = "claude" ] || [ "$host" = "all" ]; then
      configure_hook add claude "$claude_root/settings.json"
    fi
    touch "$state_dir/auto-update"
    log "auto-update enabled"
    ;;
  disable)
    if [ "$host" = "codex" ] || [ "$host" = "all" ]; then
      configure_hook remove codex "$codex_root/hooks.json"
    fi
    if [ "$host" = "claude" ] || [ "$host" = "all" ]; then
      configure_hook remove claude "$claude_root/settings.json"
    fi
    rm -f "$state_dir/auto-update"
    log "auto-update disabled"
    ;;
  preserve) ;;
esac

log "nodumbmode ready"
