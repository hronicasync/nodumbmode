#!/usr/bin/env python3

import json
import os
import shlex
import sys
import tempfile
from pathlib import Path


MARKER = "nodumbmode-auto-update"


def fail(message: str) -> None:
    print(f"nodumbmode: {message}", file=sys.stderr)
    raise SystemExit(1)


def load_config(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {path}: {error}")
    if not isinstance(data, dict):
        fail(f"{path} must contain a JSON object")
    return data


def remove_our_hooks(groups: list) -> list:
    result = []
    for group in groups:
        if not isinstance(group, dict):
            result.append(group)
            continue
        handlers = group.get("hooks")
        if not isinstance(handlers, list):
            result.append(group)
            continue
        kept = []
        for handler in handlers:
            command = handler.get("command", "") if isinstance(handler, dict) else ""
            if MARKER not in command:
                kept.append(handler)
        if kept:
            updated = dict(group)
            updated["hooks"] = kept
            result.append(updated)
    return result


def write_config(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    old_mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as temp_file:
            json.dump(data, temp_file, ensure_ascii=False, indent=2)
            temp_file.write("\n")
        os.chmod(temp_name, old_mode)
        os.replace(temp_name, path)
    except BaseException:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass
        raise


def main() -> None:
    if len(sys.argv) != 5:
        fail("usage: nodumbmode-hook-config add|remove codex|claude CONFIG UPDATER")

    action, host, config_name, updater_name = sys.argv[1:]
    if action not in {"add", "remove"}:
        fail(f"unknown action: {action}")
    if host not in {"codex", "claude"}:
        fail(f"unknown host: {host}")

    config_path = Path(config_name).expanduser()
    updater_path = Path(updater_name).expanduser().resolve()
    config = load_config(config_path)
    hooks = config.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        fail(f"hooks in {config_path} must be a JSON object")

    groups = hooks.get("SessionStart", [])
    if not isinstance(groups, list):
        fail(f"hooks.SessionStart in {config_path} must be an array")
    groups = remove_our_hooks(groups)

    if action == "add":
        command = f"{shlex.quote(str(updater_path))} --quiet # {MARKER}"
        groups.append(
            {
                "matcher": "startup|resume",
                "hooks": [
                    {
                        "type": "command",
                        "command": command,
                        "timeout": 10,
                    }
                ],
            }
        )

    if groups:
        hooks["SessionStart"] = groups
    else:
        hooks.pop("SessionStart", None)
    if not hooks:
        config.pop("hooks", None)

    write_config(config_path, config)


if __name__ == "__main__":
    main()
